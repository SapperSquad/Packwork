classTweaker	v1	official

# ShapedRecipe.pattern is private in pure vanilla (NeoForge's branches read it through a
# patch). arrangeOn3x3 lays a shaped recipe's grid - gaps and all - onto the tool roll,
# and the pattern's Optional-bearing ingredient list is the only faithful source.
accessible	field	net/minecraft/world/item/crafting/ShapedRecipe	pattern	Lnet/minecraft/world/item/crafting/ShapedRecipePattern;
